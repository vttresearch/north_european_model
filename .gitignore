# All folders except
/*/
!/docs/
!/src/
!/src_files/
!/tests/
!/.spinetoolbox/

# Documentation pages are shared. Name a page here to keep it local instead --
# a draft, or something that has not earned a link from README.md yet.
/docs/Migration guide.md

# toolbox stuff
/.spinetoolbox/items
/.spinetoolbox/local

# python
__pycache__/
.pytest_cache/

# Large time series sources are downloaded separately (see README) and the parquet
# caches are generated. Ignore everything here and allowlist the small sources that
# this repository shares. Note: subfolders (PECD-PV, PECD-onshore, PECD-offshore) are
# ignored wholesale, so a future shared subfolder needs its own '!' line for the folder.
/src_files/timeseries/*
!/src_files/timeseries/PECD-hydro-*.csv
!/src_files/timeseries/PEMMDB_*.xlsx
!/src_files/timeseries/Temperature.csv

# Same for data_scripts: the TYNDP source workbooks are downloaded and the
# Data_for_TYNDP-2024_*.xlsx output is generated by process_tyndp2024_input.py.
/src_files/data_scripts/*
!/src_files/data_scripts/*.py
!/src_files/data_scripts/historical_transfer_ramps.xlsx

# generated dataframe caches
*.parquet

# GAMS specific
*.gdx
*.gpr
*.gsp
*.lst
*.lxi
*.put
*.log*
*.gchf
*.lic

# temporary files
*.~*
*~$*
*.tmp*
*~lock*

# personal notes
todo.txt

# editor and OS files
.directory
.vscode
*.code-workspace
.idea/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
